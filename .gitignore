# Secrets — never commit these.
.env
.env.*
!.env.example
*.key
keys.txt
wallets.json

# Local storage for accounts and the findings history. Account files hold
# sealed private keys — committing one would put every generated wallet in the
# repository, encrypted but permanently.
data/
*.findings.json
findings.json
accounts.json

# Backups written by `npm run cli -- export`. Same contents as data/, so the
# same rule applies: sealed is not published.
*.backup.json
backups/

node_modules/
dist/
coverage/

# Compiled output must never sit beside the TypeScript sources. Vercel routes
# api/ by filename, so a stray api/mint.js would shadow api/mint.ts and serve
# stale code. A misconfigured rootDir emitted these once already.
api/*.js
api/*.d.ts
api/*.js.map
src/*.js
src/*.d.ts
src/*.js.map
src/routes/*.js
src/routes/*.d.ts
src/routes/*.js.map

# Local reproduction of a Vercel build.
.vercel/

npm-debug.log*
yarn-error.log*
*.tsbuildinfo

.DS_Store
.idea/
.vscode/
